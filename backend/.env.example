APP_NAME="AI Creator Studio API"
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3101","http://127.0.0.1:3101"]
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/ai_creator_studio
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters_long
ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_UPLOAD_SIZE_BYTES=2147483648
REDIS_URL=redis://localhost:6379/0
STORAGE_PATH=../storage
VOICE_TRANSCRIPTION_PROVIDER=auto
MLX_AUDIO_WORKER_PYTHON=
MLX_AUDIO_MODEL_PATH=
MLX_AUDIO_WORKER_TIMEOUT_SECONDS=1800
TRANSLATION_WORKER_URL=
TRANSLATION_WORKER_API_TOKEN=
TRANSLATION_WORKER_TIMEOUT_SECONDS=1800
ENABLE_MOCK_SCENE_PREVIEW=false
GENERATION_WORKER_URL=
GENERATION_WORKER_API_TOKEN=
GENERATION_WORKER_TIMEOUT_SECONDS=30
GENERATION_WORKER_MAX_OUTPUT_BYTES=2147483648
GENERATION_MODEL_NAME=Operator-configured self-hosted model
GENERATION_MODEL_VERSION=operator-managed
GENERATION_MODEL_REPOSITORY=
GENERATION_MODEL_LICENSE=Not declared; operator must verify the model card and weights.
GENERATION_MODEL_COMMERCIAL_USE_PERMITTED=false
GENERATION_MODEL_GPU_REQUIREMENT=External GPU worker; exact hardware depends on selected model.
GENERATION_MODEL_SUPPORTED_LANGUAGES=[]
GENERATION_MODEL_GENERATION_MODES=["text_to_video","image_to_video"]
GENERATION_MODEL_INSTALLATION_INSTRUCTIONS=Install weights manually after verifying source, license, hardware, and attribution.
PUBLIC_API_BASE_URL=http://localhost:8000
MLX_WHISPER_MODEL=mlx-community/whisper-tiny
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/publishing/youtube/oauth/callback
YOUTUBE_OAUTH_FRONTEND_RETURN_URL=http://localhost:3000/seo-publish
YOUTUBE_TOKEN_ENCRYPTION_KEY=
